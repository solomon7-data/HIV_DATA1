
        <style type="text/css">
            body {
                background-color: #C2D5F2;
            }
            body, td, th {
                color: #000;
            }

            .de-table-hdr {
                background-color: #808080 !important;
                color: #000 !important;
            }

            .de-style{
                background-color: #ffffcc;
            }

            .de-total-style{    
                font-weight: bold;
                background-color: #eee;
            }

            .ds-hdr{
                background-color: #ffffcc;
                padding: 20px;
                font-size: 20pt;
            }

            .ind-style{
                font-size: 10pt !important;
                font-weight: bold;
                background-color: #ccc;
            }
